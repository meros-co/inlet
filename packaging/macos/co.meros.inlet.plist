<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The Inlet app in the menu bar at every sign-in (and starting the sound card
  if it was stopped), as the Windows build puts it in the tray.
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>co.meros.inlet</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Applications/Inlet.app/Contents/MacOS/Inlet</string>
		<string>--tray</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
</dict>
</plist>
